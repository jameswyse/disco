# Copy to .env next to compose.yaml. Docker Compose reads it for variable substitution.
SEERR_URL=https://request.example.com
SEERR_API_KEY=replace-with-your-seerr-api-key
# Host port to publish the app on.
DISCO_PORT=8785
# Use latest, a minor series such as 0.1, or an exact release such as 0.1.0.
DISCO_VERSION=latest
