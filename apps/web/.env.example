# Seerr instance the app reads from and submits requests to.
SEERR_URL=https://request.jwnet.io
# Seerr → Settings → General → API Key. Server-only; never expose through NEXT_PUBLIC_ variables.
SEERR_API_KEY=replace-with-your-seerr-api-key
# Where saved sidebar views are stored. Defaults to ./data inside apps/web.
# DISCO_DATA_DIR=data
